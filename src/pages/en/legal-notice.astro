---
import SimplePage from '../../components/SimplePage.astro';
import { routes, routeUrl } from '../../i18n/routes';
import { profile } from '../../data/profile';
---

<SimplePage lang="en" alternates={routes.legal} title="Legal notice">
  <h1>Legal notice</h1>
  <p class="muted">
    This is an English translation for convenience. The legally binding version is the
    <a href={routeUrl('legal', 'de')} lang="de">German Impressum</a>.
  </p>

  <h2>Information pursuant to § 5 DDG (German Digital Services Act)</h2>
  <address>
    {profile.name}<br />
    {profile.address.street}<br />
    {profile.address.zipCity}<br />
    Germany
  </address>

  <h2>Contact</h2>
  <p>
    Email: <a href={`mailto:${profile.email}`}>{profile.email}</a><br />
    Alternatively via the contact form on this website.
  </p>

  <h2>Responsible for content pursuant to § 18 (2) MStV</h2>
  <p>
    {profile.name}<br />
    Address as above
  </p>

  <h2>Liability for content</h2>
  <p>
    The content of this website has been created with great care. However, I cannot guarantee that it is accurate,
    complete or up to date. As a service provider, I am responsible for my own content on these pages in accordance
    with general law (§ 7 (1) DDG).
  </p>

  <h2>Liability for links</h2>
  <p>
    This website contains links to external third-party websites over whose content I have no control. The respective
    provider or operator is always responsible for the content of linked pages. No legal violations were apparent at
    the time of linking. Should I become aware of any infringement, I will remove such links immediately.
  </p>

  <h2>Copyright</h2>
  <p>
    The content and images on this website are subject to German copyright law. Any reproduction, editing or
    distribution beyond the limits of copyright law requires prior written consent.
  </p>
</SimplePage>
