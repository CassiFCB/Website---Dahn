---
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/routes';
import { getLocalized } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const strings = t(lang);
const s = strings.education;
const p = strings.personal;
const items = await getLocalized('education', lang);
---

<section id="ausbildung" class="section section--soft" aria-labelledby="edu-title">
  <div class="container">
    <div class="section-head">
      <span class="kicker">{s.kicker}</span>
      <h2 id="edu-title">{s.title}</h2>
    </div>

    <ul class="edu">
      {
        items.map(({ data }) => (
          <li class="card item">
            <span class="period">{data.period}</span>
            <h3>{data.degree}</h3>
            <p class="inst">
              {data.institution} · {data.location}
            </p>
            {data.details.length > 0 && (
              <ul class="details">
                {data.details.map((d) => <li>{d}</li>)}
              </ul>
            )}
          </li>
        ))
      }
    </ul>

    <h2 class="personal-title" id="personal-title">{p.title}</h2>
    <div class="personal">
      <div>
        <h3>{p.languagesTitle}</h3>
        <dl class="langs">
          {
            p.languages.map((l) => (
              <div>
                <dt>{l.name}</dt>
                <dd>{l.level}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div>
        <h3>{p.engagementTitle}</h3>
        <ul class="plain">
          {
            p.engagement.map((e) => (
              <li>
                <strong>{e.role}</strong>
                <span class="muted">
                  {e.org} · {e.period}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3>{p.interestsTitle}</h3>
        <p>{p.interests}</p>
        <h3>{p.otherTitle}</h3>
        <ul class="plain">
          {p.other.map((o) => <li>{o}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .edu {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .item {
    padding: 24px;
  }
  .period {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-strong);
    margin-bottom: 8px;
  }
  .item h3 {
    font-size: 1.15rem;
  }
  .inst {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 8px;
  }
  .details {
    margin: 0;
    font-size: 0.95rem;
  }
  .personal-title {
    margin-top: clamp(56px, 8vw, 88px);
    font-size: clamp(1.6rem, 3vw, 2rem);
  }
  .personal {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    margin-top: 16px;
  }
  .personal h3 {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 12px;
  }
  .personal h3 + p + h3 {
    margin-top: 24px;
  }
  .langs {
    margin: 0;
  }
  .langs div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
  }
  .langs dt {
    font-weight: 500;
  }
  .langs dd {
    margin: 0;
    color: var(--text-muted);
  }
  .plain {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .plain li {
    display: flex;
    flex-direction: column;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
  }
  @media (max-width: 900px) {
    .edu,
    .personal {
      grid-template-columns: 1fr;
    }
  }
</style>
