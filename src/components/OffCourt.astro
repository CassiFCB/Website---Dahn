---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const strings = t(lang);
const s = strings.offcourt;
const p = strings.personal;

/* Eigene Fotos (Sport, Reisen, Alltag) einfach in src/assets/personal/ legen.
   Sie erscheinen automatisch hier, alphabetisch sortiert. Ohne Fotos bleibt der Abschnitt ohne Galerie. */
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/personal/*.{jpg,jpeg,png,webp}', {
  eager: true,
});
const photos = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default)
  .slice(0, 4);
const interests = p.interests.split(',').map((i) => i.trim());
---

<section id="persoenlich" class="offcourt" aria-labelledby="offcourt-title">
  <div class="container">
    <span class="kicker">{s.kicker}</span>
    <h2 id="offcourt-title">{s.title}</h2>

    <div class="grid">
      <ul class="interests" aria-label={p.interestsTitle}>
        {interests.map((i) => <li>{i}</li>)}
      </ul>

      <ul class="engagement">
        {
          p.engagement.map((e) => (
            <li>
              <span class="period">{e.period}</span>
              <strong>{e.role}</strong>
              <span class="org">{e.org}</span>
            </li>
          ))
        }
      </ul>
    </div>

    {
      photos.length > 0 && (
        <div class="photos">
          {photos.map((src) => (
            <Image src={src} alt="" widths={[320, 640]} sizes="(max-width: 760px) 50vw, 280px" class="photo" />
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .offcourt {
    padding-block: var(--section);
    background: var(--ink);
    color: var(--bg);
  }
  h2 {
    color: var(--bg);
  }
  .kicker {
    color: var(--accent);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 80px);
    margin-top: clamp(24px, 4vw, 40px);
  }
  .interests {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .interests li {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 800;
    font-stretch: 65%;
    text-transform: uppercase;
    line-height: 1.05;
  }
  .interests li:nth-child(odd) {
    color: var(--accent);
  }
  .engagement {
    list-style: none;
    margin: 0;
    padding: 0;
    align-self: end;
  }
  .engagement li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 18px 0;
    border-top: 1.5px solid color-mix(in srgb, var(--bg) 22%, transparent);
  }
  .period {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .engagement strong {
    font-size: 1.15rem;
  }
  .org {
    color: color-mix(in srgb, var(--bg) 70%, transparent);
  }
  .photos {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: clamp(40px, 6vw, 64px);
  }
  .photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .photos .photo:nth-child(even) {
    transform: translateY(24px);
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .photos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
